# Closer Code 环境变量配置示例
# 复制此文件为 .env 或设置系统环境变量

# ==================
# 通用配置
# ==================

# AI 提供商选择: anthropic, openai, ollama
# CLOSER_AI_PROVIDER=anthropic

# ==================
# Anthropic Claude 配置
# ==================

# API Key (必需)
# 获取地址: https://console.anthropic.com/
CLOSER_ANTHROPIC_API_KEY=sk-ant-xxx...

# API 端点 (可选，用于代理)
# CLOSER_ANTHROPIC_BASE_URL=https://api.anthropic.com

# 模型选择 (可选)
# CLOSER_ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# 最大 Token 数 (可选)
# CLOSER_ANTHROPIC_MAX_TOKENS=8192

# ==================
# OpenAI 配置
# ==================

# API Key (必需)
# 获取地址: https://platform.openai.com/api-keys
# CLOSER_OPENAI_API_KEY=sk-xxx...

# API 端点 (可选，用于代理或兼容服务)
# CLOSER_OPENAI_BASE_URL=https://api.openai.com/v1

# 模型选择 (可选)
# CLOSER_OPENAI_MODEL=gpt-4o

# 最大 Token 数 (可选)
# CLOSER_OPENAI_MAX_TOKENS=4096

# ==================
# Ollama 配置 (本地)
# ==================

# API 端点 (可选)
# CLOSER_OLLAMA_BASE_URL=http://localhost:11434

# 模型选择 (可选)
# CLOSER_OLLAMA_MODEL=llama3.1

# 最大 Token 数 (可选)
# CLOSER_OLLAMA_MAX_TOKENS=4096

# ==================
# 使用示例
# ==================

# ===== Windows CMD =====
# set CLOSER_ANTHROPIC_API_KEY=sk-ant-xxx... && npm start

# ===== Windows PowerShell =====
# $env:CLOSER_ANTHROPIC_API_KEY="sk-ant-xxx..."; npm start

# ===== Git Bash / MINGW64 =====
# export CLOSER_ANTHROPIC_API_KEY="sk-ant-xxx..." && npm start

# ===== 使用代理示例 =====
# export CLOSER_ANTHROPIC_BASE_URL="https://your-proxy.com/v1"
# export CLOSER_ANTHROPIC_API_KEY="sk-ant-xxx..."
# npm start

# ===== 切换到 OpenAI =====
# export CLOSER_AI_PROVIDER="openai"
# export CLOSER_OPENAI_API_KEY="sk-xxx..."
# npm start

# ===== 使用本地 Ollama =====
# export CLOSER_AI_PROVIDER="ollama"
# npm start
