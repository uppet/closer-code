# Closer Code 配置示例

# 将此文件复制到 ~/.closer-code/config.json 并根据需要修改

{
  # AI 提供商配置
  "ai": {
    # 选择提供商: "anthropic", "openai", 或 "ollama"
    "provider": "anthropic",

    # Anthropic Claude 配置
    "anthropic": {
      # API 密钥 (也可以通过 ANTHROPIC_API_KEY 环境变量设置)
      "apiKey": "",

      # API 基础 URL
      "baseURL": "https://api.anthropic.com",

      # 使用的模型
      "model": "claude-sonnet-4-5-20250929",

      # 最大 token 数
      "maxTokens": 8192
    },

    # OpenAI 配置
    "openai": {
      # API 密钥 (也可以通过 OPENAI_API_KEY 环境变量设置)
      "apiKey": "",

      # API 基础 URL
      "baseURL": "https://api.openai.com/v1",

      # 使用的模型
      "model": "gpt-4o",

      # 最大 token 数
      "maxTokens": 4096
    },

    # Ollama (本地运行) 配置
    "ollama": {
      # Ollama 服务地址
      "baseURL": "http://localhost:11434",

      # 使用的模型
      "model": "llama3.1",

      # 最大 token 数
      "maxTokens": 4096
    }
  },

  # 行为配置
  "behavior": {
    # 自动规划任务
    "autoPlan": true,

    # 自动执行低风险操作
    "autoExecute": false,

    # 危险操作需要确认
    "confirmDestructive": true,

    # 失败重试次数
    "maxRetries": 3,

    # 操作超时时间 (毫秒)
    "timeout": 30000,

    # 默认工作目录
    "workingDir": "/path/to/your/project"
  },

  # 工具配置
  "tools": {
    # 启用的工具列表
    "enabled": [
      "bash",           # 执行 shell 命令
      "readFile",       # 读取文件
      "writeFile",      # 写入文件
      "editFile",       # 编辑文件
      "searchFiles",    # 搜索文件
      "searchCode",     # 搜索代码
      "listFiles",      # 列出文件
      "analyzeError",   # 分析错误
      "runTests",       # 运行测试
      "planTask"        # 规划任务
    ]
  },

  # UI 配置
  "ui": {
    # 主题: "default", "dark", "light"
    "theme": "default",

    # 显示行号
    "showLineNumbers": true,

    # 最大输出行数
    "maxOutputLines": 100,

    # 自动滚动
    "autoScroll": true
  }
}

# 使用方法：
# 1. 创建配置目录
#    mkdir -p ~/.closer-code
#
# 2. 复制此文件到配置目录
#    cp config.example.json ~/.closer-code/config.json
#
# 3. 编辑配置文件，填入你的 API 密钥和偏好设置
#    nano ~/.closer-code/config.json
