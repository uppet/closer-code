{
  "name": "spawnbash-ui",
  "version": "1.0.0",
  "description": "Node.js bash 调用命令行 UI 工具",
  "main": "dist/cli.js",
  "type": "module",
  "bin": {
    "bash-ui": "./dist/cli.js"
  },
  "scripts": {
    "build": "esbuild src/cli.jsx --bundle --platform=node --format=esm --outfile=dist/cli.js --external:ink --external:react --external:ink-text-input --external:ink-select-input --external:ansi-escapes --external:chalk",
    "start": "npm run build && node dist/cli.js",
    "dev": "npm run build -- --watch"
  },
  "keywords": ["bash", "cli", "ink"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ink": "^4.4.1",
    "react": "^18.2.0",
    "ink-select-input": "^5.0.0",
    "ink-text-input": "^5.0.1",
    "ansi-escapes": "^6.2.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.20.0"
  }
}
